# Copy this file to `.env` (already gitignored) and fill in your real key.
# Never commit `.env`. The app loads it via python-dotenv at startup and
# never prints or logs the key value.

# Required for the real OpenAI-backed agent (CLI --real mode, and the API's
# default runtime backend). Without this set, the API/CLI still start, but
# any attempt to run an objective returns a clear "LLM not configured"
# error/banner instead of silently falling back to the deterministic mock.
OPENAI_API_KEY=sk-your-key-here

# Chat Completions model used for native tool calling. gpt-4o-mini is a
# good default: cheap, fast, and supports the `tools=` parameter.
OPENAI_MODEL=gpt-4o-mini

# Postgres connection string (see docker-compose.yml at the project root:
# `docker compose up -d postgres` exposes it on host port 5433). Defaults to
# this same value if unset.
DATABASE_URL=postgresql://agent_harness:agent_harness@localhost:5433/agent_harness

# MLflow tracing/eval backend (see docker-compose.yml's `mlflow` service:
# `docker compose up -d` exposes its UI/API on host port 5001). Empty/unset
# disables MLflow tracing entirely (unit tests run this way by default, so
# they never require the server running). Set it to see real traces from a
# live run or from `python -m agent_harness.eval.run_eval`.
MLFLOW_TRACKING_URI=http://localhost:5001
# MLFLOW_EXPERIMENT_NAME=agent-harness

# How long a run waits for a human to approve/deny a gated tool call before it
# ends as `cancelled` (with an `approval_timed_out` event). This human wait is
# excluded from the agent's own wall-clock limit. Default: 900 (15 min).
# APPROVAL_TIMEOUT_SECONDS=900

# Optional overrides (defaults shown; relative to the agent-harness/ root).
# AGENT_HARNESS_KB_DIR=data/kb
# AGENT_HARNESS_SEED_SERVICES=data/seed/services.json
